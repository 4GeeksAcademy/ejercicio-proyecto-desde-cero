# Copia este archivo a .env y cambia los valores. NUNCA subas .env a Git.
# Todos los valores de abajo son ejemplos de desarrollo, no secretos reales.

# --- Entorno ---
APP_ENV=development            # development | testing | staging | production
LOG_LEVEL=INFO

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=tallerya
POSTGRES_PASSWORD=cambia_esto_en_tu_.env
POSTGRES_DB=tallerya
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=3000

# --- Seguridad ---
# Genera uno propio: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio

# --- Pagos (proveedor real: pendiente de decisión del cliente) ---
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
FRONTEND_URL=http://localhost:3000

# --- Observabilidad (opcional; ver docker-compose.yml, perfil "observability") ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
